# ===================================================================
# Agentic Data Migration Planner & Reconciliation Workbench
# Environment Variables Template
# ===================================================================
# Copy this file to `.env` and fill in the values.
# cp .env.example .env

# --- Backend Database Paths ---
APP_DB_URL=sqlite:///./app.db
TARGET_DB_URL=sqlite:///./target.db

# --- Fault Injection ---
# Safety default: false. Only enable for explicit chaos testing.
ENABLE_FAULT_INJECTION=false

# --- AI Agent (Optional: enables LLM mode) ---
# Leave blank to auto-use deterministic fallback agent
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# --- Backend Server ---
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# --- Frontend Dev Server ---
VITE_API_BASE_URL=http://127.0.0.1:8000
